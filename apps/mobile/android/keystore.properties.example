# Copy this file to `keystore.properties` (git-ignored) and fill in the values
# to build a signed release locally. In CI, the same values are supplied through
# the environment (see .github/workflows/release-android.yml).
#
# Create the keystore once with:
#   keytool -genkeypair -v -keystore abbabal-release.keystore \
#     -alias abbabal -keyalg RSA -keysize 2048 -validity 10000
#
# `storeFile` is resolved relative to the Android app module
# (apps/mobile/android/app), so `../abbabal-release.keystore` lives in
# apps/mobile/android/.
storeFile=../abbabal-release.keystore
storePassword=change-me
keyAlias=abbabal
keyPassword=change-me
